rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isOwnedParentGroup(userId, groupId) {
      return exists(/databases/$(database)/documents/users/$(userId)/groups/$(groupId)) &&
        get(/databases/$(database)/documents/users/$(userId)/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    // Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'gradeCourse', 'activeGroupId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'displayName', 'gradeCourse', 'activeGroupId', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.gradeCourse is string && data.gradeCourse.size() >= 1 && data.gradeCourse.size() <= 80 &&
        data.activeGroupId is string && data.activeGroupId.size() >= 1 && data.activeGroupId.size() <= 128 && data.activeGroupId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidStudentGroupDoc(data, userId) {
      return data.keys().hasAll(['ownerId', 'name', 'course', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'course', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.course is string && data.course.size() >= 1 && data.course.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidStudentTaskDoc(data, userId, groupId) {
      return data.keys().hasAll(['ownerId', 'groupId', 'title', 'assignee', 'dueDate', 'priority', 'kanbanColumn', 'evidenceUrl', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'groupId', 'title', 'assignee', 'dueDate', 'priority', 'kanbanColumn', 'evidenceUrl', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 128 && data.groupId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.groupId == groupId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.assignee is string && data.assignee.size() >= 1 && data.assignee.size() <= 80 &&
        data.dueDate is string && data.dueDate.size() >= 1 && data.dueDate.size() <= 30 &&
        data.priority is string && data.priority.size() >= 4 && data.priority.size() <= 10 &&
        data.priority in ['Alta', 'Media', 'Baja'] &&
        data.kanbanColumn is string && data.kanbanColumn.size() >= 9 && data.kanbanColumn.size() <= 15 &&
        data.kanbanColumn in ['Por Hacer', 'En Progreso', 'Terminado'] &&
        data.evidenceUrl is string && data.evidenceUrl.size() >= 0 && data.evidenceUrl.size() <= 500 &&
        (data.kanbanColumn != 'Terminado' || data.evidenceUrl.size() > 0) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidStudentResourceDoc(data, userId, groupId) {
      return data.keys().hasAll(['ownerId', 'groupId', 'title', 'category', 'url', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'groupId', 'title', 'category', 'url', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 128 && data.groupId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.groupId == groupId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // 1. Public Profile Metadata (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId) && existing().ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserPublicProfile(incoming(), userId) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidUserPublicProfile(incoming(), userId) && isOwner(userId) && isValidId(userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt && (
          // Action: Switch active group
          incoming().diff(existing()).affectedKeys().hasOnly(['activeGroupId', 'updatedAt']) ||
          // Action: Update profile details
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'gradeCourse', 'activeGroupId', 'updatedAt'])
        );
      allow delete: if false;

      // 2. Isolated PII Split Collection (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && existing().ownerId == request.auth.uid;
        allow list: if false;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) && incoming().createdAt == request.time;
        allow update: if isSignedIn() && isValidUserPrivateInfo(incoming(), userId) && isOwner(userId) && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      // 3. Student Groups (/users/{userId}/groups/{groupId})
      match /groups/{groupId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(groupId) &&
          isValidStudentGroupDoc(incoming(), userId) && incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn() && isValidStudentGroupDoc(incoming(), userId) && isOwner(userId) && isValidId(userId) && isValidId(groupId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'course', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && existing().ownerId == request.auth.uid;

        // 4. Group Tasks (/users/{userId}/groups/{groupId}/tasks/{taskId})
        match /tasks/{taskId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(taskId) &&
            existing().ownerId == request.auth.uid && isOwnedParentGroup(userId, groupId);
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid && resource.data.groupId == groupId;
          allow create: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(taskId) &&
            isValidStudentTaskDoc(incoming(), userId, groupId) && incoming().createdAt == request.time &&
            isOwnedParentGroup(userId, groupId);
          allow update: if isSignedIn() && isValidStudentTaskDoc(incoming(), userId, groupId) && isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(taskId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().groupId == existing().groupId &&
            incoming().createdAt == existing().createdAt &&
            existing().kanbanColumn != 'Terminado' &&
            isOwnedParentGroup(userId, groupId) && (
              // Action: Transition Kanban column or attach evidence
              incoming().diff(existing()).affectedKeys().hasOnly(['kanbanColumn', 'evidenceUrl', 'updatedAt']) ||
              // Action: Edit task details
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'assignee', 'dueDate', 'priority', 'kanbanColumn', 'evidenceUrl', 'updatedAt'])
            );
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(taskId) &&
            existing().ownerId == request.auth.uid && isOwnedParentGroup(userId, groupId);
        }

        // 5. Group Anchored Resources (/users/{userId}/groups/{groupId}/resources/{resourceId})
        match /resources/{resourceId} {
          allow get: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(resourceId) &&
            existing().ownerId == request.auth.uid && isOwnedParentGroup(userId, groupId);
          allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid && resource.data.groupId == groupId;
          allow create: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(resourceId) &&
            isValidStudentResourceDoc(incoming(), userId, groupId) && incoming().createdAt == request.time &&
            isOwnedParentGroup(userId, groupId);
          allow update: if isSignedIn() && isValidStudentResourceDoc(incoming(), userId, groupId) && isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(resourceId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().groupId == existing().groupId &&
            incoming().createdAt == existing().createdAt &&
            isOwnedParentGroup(userId, groupId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'url', 'updatedAt']);
          allow delete: if isOwner(userId) && isValidId(userId) && isValidId(groupId) && isValidId(resourceId) &&
            existing().ownerId == request.auth.uid && isOwnedParentGroup(userId, groupId);
        }
      }
    }
  }
}
