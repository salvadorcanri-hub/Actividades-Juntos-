{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public student profile metadata without PII.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated student owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student full display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "gradeLevel": {
          "type": "string",
          "description": "Student grade level from 1 to 5.",
          "enum": ["1", "2", "3", "4", "5"],
          "minLength": 1,
          "maxLength": 2
        },
        "sectionLetter": {
          "type": "string",
          "description": "Student section letter from A to C.",
          "enum": ["A", "B", "C"],
          "minLength": 1,
          "maxLength": 2
        },
        "gradeCourse": {
          "type": "string",
          "description": "Formatted student grade and school section.",
          "minLength": 1,
          "maxLength": 80
        },
        "activeGroupId": {
          "type": "string",
          "description": "Currently selected group ID for this student (empty string when no groups exist).",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^(|[a-zA-Z0-9_\\-]+)$"
        },
        "profileCompleted": {
          "type": "boolean",
          "description": "Indicates whether the student has completed initial grade/section setup."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "gradeLevel",
        "sectionLetter",
        "gradeCourse",
        "activeGroupId",
        "profileCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing the student email address.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated student owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified student email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["ownerId", "email", "createdAt", "updatedAt"]
    },
    "SharedGroupDoc": {
      "title": "SharedGroupDoc",
      "description": "Collaborative course project group shared across multiple authenticated students.",
      "type": "object",
      "properties": {
        "creatorId": {
          "type": "string",
          "description": "Immutable UID of the student who created the group (highest rank).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorName": {
          "type": "string",
          "description": "Display name of the group creator.",
          "minLength": 1,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "description": "Project group name.",
          "minLength": 1,
          "maxLength": 100
        },
        "course": {
          "type": "string",
          "description": "Course or subject name.",
          "minLength": 1,
          "maxLength": 100
        },
        "inviteCode": {
          "type": "string",
          "description": "Unique uppercase invite code used by teammates to join.",
          "minLength": 3,
          "maxLength": 12,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "coverUrl": {
          "type": "string",
          "description": "Optional cover image path or safe HTTPS URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "memberIds": {
          "type": "array",
          "description": "Bounded list (max 20) of authenticated member UIDs who have access to this group."
        },
        "members": {
          "type": "array",
          "description": "Bounded list (max 20) of member display names for workload and assignment."
        },
        "activityLog": {
          "type": "array",
          "description": "Bounded chronological project activity log entries (max 80)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "creatorId",
        "creatorName",
        "name",
        "course",
        "inviteCode",
        "coverUrl",
        "memberIds",
        "members",
        "activityLog",
        "createdAt",
        "updatedAt"
      ]
    },
    "GroupInviteDoc": {
      "title": "GroupInviteDoc",
      "description": "Lookup index mapping an exact invite code to its shared group ID.",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Target shared group document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "creatorId": {
          "type": "string",
          "description": "UID of the group creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "groupName": {
          "type": "string",
          "description": "Name of the target group.",
          "minLength": 1,
          "maxLength": 100
        },
        "course": {
          "type": "string",
          "description": "Course name of the target group.",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "groupId",
        "creatorId",
        "groupName",
        "course",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedTaskDoc": {
      "title": "SharedTaskDoc",
      "description": "Collaborative task card inside a shared group with Anti-Paseos validation, creator review, notes, grades, timestamps, subtasks, and private edit history.",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Parent shared group ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the student who created the task.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Task title.",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Optional task description.",
          "minLength": 0,
          "maxLength": 300
        },
        "assignee": {
          "type": "string",
          "description": "Assigned team member display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "dueDate": {
          "type": "string",
          "description": "Due date ISO string (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 30
        },
        "priority": {
          "type": "string",
          "description": "Priority level.",
          "enum": ["Alta", "Media", "Baja"],
          "minLength": 4,
          "maxLength": 10
        },
        "kanbanColumn": {
          "type": "string",
          "description": "Current Kanban column state.",
          "enum": ["Por Hacer", "En Progreso", "Terminado"],
          "minLength": 9,
          "maxLength": 15
        },
        "evidenceUrl": {
          "type": "string",
          "description": "Mandatory HTTP(S) evidence link when kanbanColumn is Terminado.",
          "minLength": 0,
          "maxLength": 500,
          "pattern": "^(|https?://[^\\s]+)$"
        },
        "evidenceReviewStatus": {
          "type": "string",
          "description": "Review status controlled by the group creator.",
          "enum": ["", "pendiente", "verificada", "observada", "rechazada"],
          "minLength": 0,
          "maxLength": 20
        },
        "evidenceReviewNote": {
          "type": "string",
          "description": "Review note left by the group creator.",
          "minLength": 0,
          "maxLength": 120
        },
        "coordinatorNote": {
          "type": "string",
          "description": "Direct guidance note from the group creator.",
          "minLength": 0,
          "maxLength": 240
        },
        "coordinatorNoteBy": {
          "type": "string",
          "description": "Creator display name who wrote the note.",
          "minLength": 0,
          "maxLength": 80
        },
        "coordinatorNoteUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp when coordinator note was updated.",
          "minLength": 0,
          "maxLength": 40
        },
        "teacherRating": {
          "type": "number",
          "description": "Teacher grade (0-20), or -1 when ungraded."
        },
        "teacherComment": {
          "type": "string",
          "description": "Teacher feedback comment.",
          "minLength": 0,
          "maxLength": 200
        },
        "startedAt": {
          "type": "string",
          "description": "ISO timestamp when task entered En Progreso.",
          "minLength": 0,
          "maxLength": 40
        },
        "completedAt": {
          "type": "string",
          "description": "ISO timestamp when task was completed.",
          "minLength": 0,
          "maxLength": 40
        },
        "subtasks": {
          "type": "array",
          "description": "Bounded list (max 25) of subtask checklist items."
        },
        "editHistory": {
          "type": "array",
          "description": "Bounded list (max 40) of task correction audit entries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "groupId",
        "createdBy",
        "title",
        "description",
        "assignee",
        "dueDate",
        "priority",
        "kanbanColumn",
        "evidenceUrl",
        "evidenceReviewStatus",
        "evidenceReviewNote",
        "coordinatorNote",
        "coordinatorNoteBy",
        "coordinatorNoteUpdatedAt",
        "teacherRating",
        "teacherComment",
        "startedAt",
        "completedAt",
        "subtasks",
        "editHistory",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedResourceDoc": {
      "title": "SharedResourceDoc",
      "description": "Anchored course resource link inside a shared group.",
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "description": "Parent shared group ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the student who pinned the resource.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Resource title.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Resource category label.",
          "minLength": 1,
          "maxLength": 60
        },
        "url": {
          "type": "string",
          "description": "Safe HTTP(S) resource URL.",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^https?://[^\\s]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "groupId",
        "createdBy",
        "title",
        "category",
        "url",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public profile metadata for a student user."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Split collection isolating student PII (email)."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/SharedGroupDoc" },
      "description": "Collaborative course project groups shared across students."
    },
    "/groupInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/GroupInviteDoc" },
      "description": "Exact-match invite code lookup table for joining a shared group."
    },
    "/groups/{groupId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/SharedTaskDoc" },
      "description": "Collaborative tasks belonging to a shared group."
    },
    "/groups/{groupId}/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/SharedResourceDoc" },
      "description": "Anchored course resources belonging to a shared group."
    }
  }
}
