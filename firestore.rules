rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 12 && code.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Allows verified OAuth accounts (e.g. Google) and real Email/Password accounts (blocks anonymous)
    function isVerifiedUser() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        (request.auth.token.email_verified == true ||
          request.auth.token.firebase.sign_in_provider == 'password');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function parentGroupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return parentGroupExists(groupId) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupCreator(groupId) {
      return parentGroupExists(groupId) &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId == request.auth.uid;
    }

    // Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'gradeLevel', 'sectionLetter',
          'gradeCourse', 'activeGroupId', 'profileCompleted', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'displayName', 'gradeLevel', 'sectionLetter',
          'gradeCourse', 'activeGroupId', 'profileCompleted', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.gradeLevel is string && data.gradeLevel.size() >= 1 && data.gradeLevel.size() <= 2 &&
        data.gradeLevel in ['1', '2', '3', '4', '5'] &&
        data.sectionLetter is string && data.sectionLetter.size() >= 1 && data.sectionLetter.size() <= 2 &&
        data.sectionLetter in ['A', 'B', 'C'] &&
        data.gradeCourse is string && data.gradeCourse.size() >= 1 && data.gradeCourse.size() <= 80 &&
        data.activeGroupId is string && data.activeGroupId.size() <= 128 &&
        (data.activeGroupId == '' || data.activeGroupId.matches('^[a-zA-Z0-9_\\-]+$')) &&
        data.profileCompleted is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'createdAt', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidSharedGroupDoc(data) {
      return data.keys().hasAll([
          'creatorId', 'creatorName', 'name', 'course', 'inviteCode',
          'coverUrl', 'memberIds', 'members', 'activityLog', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'creatorId', 'creatorName', 'name', 'course', 'inviteCode',
          'coverUrl', 'memberIds', 'members', 'activityLog', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.creatorId) &&
        data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 80 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.course is string && data.course.size() >= 1 && data.course.size() <= 100 &&
        isValidInviteCode(data.inviteCode) &&
        data.coverUrl is string && data.coverUrl.size() <= 500 &&
        (data.coverUrl == '' || data.coverUrl.matches('^(/|https?://)[^\\s]+$')) &&
        data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 20 &&
        data.memberIds[0] is string && data.creatorId in data.memberIds &&
        data.members is list && data.members.size() >= 1 && data.members.size() <= 20 &&
        data.members[0] is string &&
        data.activityLog is list && data.activityLog.size() <= 80 &&
        (data.activityLog.size() == 0 || data.activityLog[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidGroupInviteDoc(data) {
      return data.keys().hasAll(['groupId', 'creatorId', 'groupName', 'course', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['groupId', 'creatorId', 'groupName', 'course', 'createdAt', 'updatedAt']) &&
        isValidId(data.groupId) &&
        isValidId(data.creatorId) &&
        data.creatorId == request.auth.uid &&
        data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 100 &&
        data.course is string && data.course.size() >= 1 && data.course.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidSharedTaskDoc(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'createdBy', 'title', 'description', 'assignee', 'dueDate',
          'priority', 'kanbanColumn', 'evidenceUrl', 'evidenceReviewStatus',
          'evidenceReviewNote', 'coordinatorNote', 'coordinatorNoteBy',
          'coordinatorNoteUpdatedAt', 'teacherRating', 'teacherComment',
          'startedAt', 'completedAt', 'subtasks', 'editHistory', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'createdBy', 'title', 'description', 'assignee', 'dueDate',
          'priority', 'kanbanColumn', 'evidenceUrl', 'evidenceReviewStatus',
          'evidenceReviewNote', 'coordinatorNote', 'coordinatorNoteBy',
          'coordinatorNoteUpdatedAt', 'teacherRating', 'teacherComment',
          'startedAt', 'completedAt', 'subtasks', 'editHistory', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.groupId) && data.groupId == groupId &&
        isValidId(data.createdBy) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 300 &&
        data.assignee is string && data.assignee.size() >= 1 && data.assignee.size() <= 80 &&
        data.dueDate is string && data.dueDate.size() >= 1 && data.dueDate.size() <= 30 &&
        data.priority is string && data.priority.size() >= 4 && data.priority.size() <= 10 &&
        data.priority in ['Alta', 'Media', 'Baja'] &&
        data.kanbanColumn is string && data.kanbanColumn.size() >= 9 && data.kanbanColumn.size() <= 15 &&
        data.kanbanColumn in ['Por Hacer', 'En Progreso', 'Terminado'] &&
        data.evidenceUrl is string && data.evidenceUrl.size() <= 500 &&
        (data.evidenceUrl == '' || data.evidenceUrl.matches('^https?://[^\\s]+$')) &&
        (data.kanbanColumn != 'Terminado' || data.evidenceUrl.size() > 0) &&
        data.evidenceReviewStatus is string && data.evidenceReviewStatus.size() <= 20 &&
        data.evidenceReviewStatus in ['', 'pendiente', 'verificada', 'observada', 'rechazada'] &&
        data.evidenceReviewNote is string && data.evidenceReviewNote.size() <= 120 &&
        data.coordinatorNote is string && data.coordinatorNote.size() <= 240 &&
        data.coordinatorNoteBy is string && data.coordinatorNoteBy.size() <= 80 &&
        data.coordinatorNoteUpdatedAt is string && data.coordinatorNoteUpdatedAt.size() <= 40 &&
        data.teacherRating is number && (data.teacherRating == -1 || (data.teacherRating >= 0 && data.teacherRating <= 20)) &&
        data.teacherComment is string && data.teacherComment.size() <= 200 &&
        data.startedAt is string && data.startedAt.size() <= 40 &&
        data.completedAt is string && data.completedAt.size() <= 40 &&
        data.subtasks is list && data.subtasks.size() <= 25 &&
        (data.subtasks.size() == 0 || data.subtasks[0] is map) &&
        data.editHistory is list && data.editHistory.size() <= 40 &&
        (data.editHistory.size() == 0 || data.editHistory[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidSharedResourceDoc(data, groupId) {
      return data.keys().hasAll(['groupId', 'createdBy', 'title', 'category', 'url', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['groupId', 'createdBy', 'title', 'category', 'url', 'createdAt', 'updatedAt']) &&
        isValidId(data.groupId) && data.groupId == groupId &&
        isValidId(data.createdBy) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 500 &&
        data.url.matches('^https?://[^\\s]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // 1. Public Profile Metadata (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId) &&
        (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserPublicProfile(incoming(), userId) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && isValidUserPublicProfile(incoming(), userId) &&
        isOwner(userId) && isValidId(userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt && (
          // Action: Switch active group
          incoming().diff(existing()).affectedKeys().hasOnly(['activeGroupId', 'updatedAt']) ||
          // Action: Update grade/section/display profile
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'gradeLevel', 'sectionLetter', 'gradeCourse', 'profileCompleted', 'activeGroupId', 'updatedAt'])
        );
      allow delete: if false;

      // 2. Isolated PII Split Collection (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) &&
          (resource == null || existing().ownerId == request.auth.uid);
        allow list: if false;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          isValidUserPrivateInfo(incoming(), userId) && incoming().createdAt == request.time;
        allow update: if isSignedIn() && isValidUserPrivateInfo(incoming(), userId) &&
          isOwner(userId) && isValidId(userId) && isValidId(docId) && docId == 'info' &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }

    // 3. Exact-Match Invite Code Lookup (/groupInvites/{inviteCode})
    match /groupInvites/{inviteCode} {
      allow get: if isVerifiedUser() && isValidInviteCode(inviteCode);
      allow list: if false;
      allow create: if isVerifiedUser() && isValidInviteCode(inviteCode) &&
        isValidGroupInviteDoc(incoming()) && incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/groups/$(incoming().groupId));
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidInviteCode(inviteCode) && existing().creatorId == request.auth.uid;
    }

    // 4. Shared Multi-User Course Groups (/groups/{groupId})
    match /groups/{groupId} {
      allow get: if isVerifiedUser() && isValidId(groupId) &&
        resource != null && request.auth.uid in existing().memberIds;
      allow list: if isVerifiedUser() && request.auth.uid in resource.data.memberIds;
      allow create: if isVerifiedUser() && isValidId(groupId) &&
        isValidSharedGroupDoc(incoming()) &&
        incoming().creatorId == request.auth.uid &&
        incoming().memberIds.size() == 1 &&
        request.auth.uid in incoming().memberIds &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() && isValidSharedGroupDoc(incoming()) &&
        isVerifiedUser() && isValidId(groupId) &&
        incoming().creatorId == existing().creatorId &&
        incoming().creatorName == existing().creatorName &&
        incoming().inviteCode == existing().inviteCode &&
        incoming().createdAt == existing().createdAt && (
          // Action: Creator manages group info, members (add/kick), and activity log
          (existing().creatorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'course', 'coverUrl', 'memberIds', 'members', 'activityLog', 'updatedAt'])) ||
          // Action: Verified student joins via valid invite code (may only append own UID and own name)
          (!(request.auth.uid in existing().memberIds) &&
            request.auth.uid in incoming().memberIds &&
            incoming().memberIds.hasAll(existing().memberIds) &&
            incoming().memberIds.size() == existing().memberIds.size() + 1 &&
            incoming().members.hasAll(existing().members) &&
            incoming().members.size() >= existing().members.size() &&
            incoming().members.size() <= existing().members.size() + 1 &&
            exists(/databases/$(database)/documents/groupInvites/$(existing().inviteCode)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'members', 'activityLog', 'updatedAt'])) ||
          // Action: Existing member appends activity log entry
          (request.auth.uid in existing().memberIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['activityLog', 'updatedAt']))
        );
      // Disolver Grupo: STRICTLY creator-only
      allow delete: if isVerifiedUser() && isValidId(groupId) && existing().creatorId == request.auth.uid;

      // 5. Shared Group Tasks (/groups/{groupId}/tasks/{taskId})
      match /tasks/{taskId} {
        allow get: if isVerifiedUser() && isValidId(groupId) && isValidId(taskId) &&
          isGroupMember(groupId) && (resource == null || existing().groupId == groupId);
        allow list: if isVerifiedUser() && resource.data.groupId == groupId && isGroupMember(groupId);
        allow create: if isVerifiedUser() && isValidId(groupId) && isValidId(taskId) &&
          isValidSharedTaskDoc(incoming(), groupId) &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          isGroupMember(groupId) &&
          (isGroupCreator(groupId) || (
            incoming().kanbanColumn == 'Por Hacer' &&
            incoming().evidenceReviewStatus in ['', 'pendiente'] &&
            incoming().coordinatorNote == '' &&
            incoming().teacherRating == -1
          ));
        allow update: if isSignedIn() && isValidSharedTaskDoc(incoming(), groupId) &&
          isVerifiedUser() && isValidId(groupId) && isValidId(taskId) &&
          incoming().groupId == existing().groupId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt && (
            // Tier 1: Group Creator full task management (status transitions, review, notes, grades, edits)
            (isGroupCreator(groupId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'description', 'assignee', 'dueDate', 'priority',
                'kanbanColumn', 'evidenceUrl', 'evidenceReviewStatus', 'evidenceReviewNote',
                'coordinatorNote', 'coordinatorNoteBy', 'coordinatorNoteUpdatedAt',
                'teacherRating', 'teacherComment', 'startedAt', 'completedAt',
                'subtasks', 'editHistory', 'updatedAt'
              ])) ||
            // Tier 2A: Group Member toggles/adds subtasks
            (isGroupMember(groupId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['subtasks', 'updatedAt'])) ||
            // Tier 2B: Group Member attaches evidence or corrects task (#4) without changing status/grades/approval
            (isGroupMember(groupId) &&
              (incoming().evidenceReviewStatus == existing().evidenceReviewStatus ||
                incoming().evidenceReviewStatus in ['', 'pendiente']) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'dueDate', 'priority', 'evidenceUrl',
                'evidenceReviewStatus', 'startedAt', 'editHistory', 'updatedAt'
              ]))
          );
        // Delete task: STRICTLY creator-only (also used when dissolving group)
        allow delete: if isVerifiedUser() && isValidId(groupId) && isValidId(taskId) && isGroupCreator(groupId);
      }

      // 6. Shared Group Anchored Resources (/groups/{groupId}/resources/{resourceId})
      match /resources/{resourceId} {
        allow get: if isVerifiedUser() && isValidId(groupId) && isValidId(resourceId) &&
          isGroupMember(groupId) && (resource == null || existing().groupId == groupId);
        allow list: if isVerifiedUser() && resource.data.groupId == groupId && isGroupMember(groupId);
        allow create: if isVerifiedUser() && isValidId(groupId) && isValidId(resourceId) &&
          isValidSharedResourceDoc(incoming(), groupId) &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          isGroupMember(groupId);
        allow update: if isSignedIn() && isValidSharedResourceDoc(incoming(), groupId) &&
          isVerifiedUser() && isValidId(groupId) && isValidId(resourceId) &&
          incoming().groupId == existing().groupId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          isGroupMember(groupId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'url', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(groupId) && isValidId(resourceId) &&
          (isGroupCreator(groupId) || (existing().createdBy == request.auth.uid && isGroupMember(groupId)));
      }
    }
  }
}
